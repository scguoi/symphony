FROM debian:trixie-slim

ARG TARGETARCH
ARG CODEX_VERSION=0.134.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    openssh-server \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "$TARGETARCH" in \
      arm64) codex_arch="aarch64" ;; \
      amd64) codex_arch="x86_64" ;; \
      *) echo "Unsupported Docker architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-${codex_arch}-unknown-linux-musl.tar.gz" \
      | tar -xz -C /usr/local/bin; \
    chmod +x /usr/local/bin/codex-${codex_arch}-unknown-linux-musl; \
    ln -s /usr/local/bin/codex-${codex_arch}-unknown-linux-musl /usr/local/bin/codex; \
    codex --version

RUN mkdir -p /run/sshd /workspaces \
    && sed -i 's/^#PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config \
    && sed -i 's/^#PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config

COPY scripts/worker-entrypoint.sh /usr/local/bin/worker-entrypoint
COPY scripts/forgeflow-demo-app-server /usr/local/bin/forgeflow-demo-app-server
RUN chmod +x /usr/local/bin/worker-entrypoint /usr/local/bin/forgeflow-demo-app-server

EXPOSE 22

ENTRYPOINT ["worker-entrypoint"]
